# Auto-detect text files, normalize line endings
* text=auto eol=lf

# Explicit text + lf overrides
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
*.lock  text eol=lf -diff

# Shell scripts must keep lf even on Windows
*.sh    text eol=lf

# Binary defaults
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Linguist — markdown is documentation
*.md linguist-documentation
