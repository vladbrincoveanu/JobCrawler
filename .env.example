# JobCrawler — copy to .env, never commit
# Postgres connection (local docker-compose defaults)
DATABASE_URL=postgresql://jobcrawler:dev@localhost:5433/jobcrawler

# Sub-project 1 (AMS crawler)
AMS_BASE_URL=https://jobs.ams.at/public/
AMS_COOKIE_DOMAIN=.ams.at

# Logging
LOG_FORMAT=text

# --- Dashboard (dashboard/) -------------------------------------------------
# Sign-in password. UNSET = fail closed: every mutating route refuses and the
# /profiles page is read-only. Set this on any deployment strangers can reach.
DASHBOARD_PASSWORD=

# The CV config lives in this repository and the dashboard commits to it.
# Fine-grained PAT, this repo only, Contents + Actions read/write. Without both
# of these the dashboard falls back to reading the local checkout.
GITHUB_REPO=owner/name
GITHUB_TOKEN=
GITHUB_BRANCH=main

# Where the scheduled scan publishes its results (the scout-data branch).
SCOUT_FEED_BASE_URL=https://raw.githubusercontent.com/owner/name/scout-data
# Legacy SINGLE-CV feed, honoured only when no CV is named. Kept one release.
SCOUT_FEED_URL=

# Local-checkout only. Upload-and-scan on /scout shells out to scripts/scout.py;
# these point at it. SCOUT_LOCAL_SCAN=1 forces that route on even when the
# script is not where the dashboard expects it -- do not set it on a deployment.
SCOUT_LOCAL_SCAN=
SCOUT_PYTHON_BIN=
SCOUT_REPO_ROOT=
SCOUT_CONFIG_ROOT=
SCOUT_FEED_DIR=
SCOUT_FEED_PATH=
SCOUT_DEFAULT_SOURCES=

# Optional, read by both the dashboard and the scheduled scan.
NVIDIA_API_KEY=
